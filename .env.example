# Credenciales de tu proyecto de Firebase (Configuración del proyecto → General → Tus apps → SDK setup and configuration).
# Copiá este archivo a ".env" y completá los valores. Nunca subas ".env" al repo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
