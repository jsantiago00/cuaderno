rules_version = '2';

// Reglas de seguridad para Firestore: cada usuario autenticado sólo puede
// leer y escribir sus propias notas. Pegar esto en Firebase Console →
// Firestore Database → Reglas (ver README.md).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/notes/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
